// Pre-MSAA stencil restore shader.
// Copies saved diffuse values back to the post-SSAO diffuse buffer for excluded pixels.
// Runs AFTER the SSAO pass, where the diffuse is non-MSAA (resolved).
//
// Reads the MSAA temp buffer directly (Texture2DMS) using sample 0, skipping the
// resolve step entirely. This avoids MSAA resolve edge blending that would produce
// gray outlines at mesh silhouettes (the resolve averages saved pixels with the
// clear color at edges, creating blended intermediate values).
//
// No stencil testing is needed here. The temp buffer was written by the save pass
// which used hardware stencil to only save excluded pixels. Included pixels in the
// temp buffer are zero (from the clear). We check alpha to identify saved pixels.

#include <Atom/Features/SrgSemantics.azsli>
#include <Atom/Features/PostProcessing/FullscreenVertex.azsli>
#include <Atom/Features/PostProcessing/FullscreenPixelInfo.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2DMS<float4> m_source;  // MSAA temp buffer (not resolved)
}

PSOutput MainPS(VSOutput IN)
{
    uint2 screenCoords = uint2(IN.m_position.xy);

    // Load sample 0 directly from the MSAA buffer. No resolve = no edge blending.
    float4 saved = PassSrg::m_source.Load(screenCoords, 0);

    // Saved pixels have alpha = -1 (from the forward pass's m_diffuseColor.a).
    // Clear pixels have alpha = 0. Discard anything that isn't a fully saved pixel.
    static const float ALPHA_EPSILON = 0.01;  // Tolerance for floating point precision
    if (saved.a > -1.0 + ALPHA_EPSILON)
    {
        discard;
    }

    PSOutput OUT;
    OUT.m_color = saved;
    return OUT;
}
