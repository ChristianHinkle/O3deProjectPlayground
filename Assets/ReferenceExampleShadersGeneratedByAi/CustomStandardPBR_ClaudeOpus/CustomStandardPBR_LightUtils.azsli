// Custom LightUtil overrides for CustomStandardPBR.
// Per-light shading uses the engine's default PBR calculations (no overrides).
//
// To customize per-light shading, add LightUtil class overrides here following the
// pattern in CustomMinimalPBR_LightUtilOverride_LightUtils.azsli. Define #define macros for each light
// type before StandardPBR_LightingEval.azsli includes Lights.azsli.
//
// Note: For most customization, modifying GetDiffuseLighting_Custom/GetSpecularLighting_Custom
// in CustomStandardPBR_LightingBrdf.azsli is simpler and sufficient — it affects all lights
// without duplicating any attenuation math.

#pragma once

// No LightUtil overrides — engine defaults are used.
