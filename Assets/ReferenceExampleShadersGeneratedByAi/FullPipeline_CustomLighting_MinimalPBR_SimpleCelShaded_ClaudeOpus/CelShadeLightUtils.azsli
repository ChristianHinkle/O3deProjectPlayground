// Custom LightUtil overrides for cel-shaded lighting.
// Cel-shading is applied at the aggregate output stage in the pixel shader, not per-light.
// Per-light shading uses the engine's default PBR calculations (no overrides).
//
// To customize per-light shading, add LightUtil class overrides here following the
// pattern in CustomMinimalPBR_LightUtils.azsli. Define #define macros for each light
// type before StandardLighting.azsli is included.
//
// PREREQUISITES: Surface, LightingData, LightingUtils, and Brdf must be defined before including this file.
//
// Include this file BEFORE including StandardLighting.azsli.

#pragma once

// No LightUtil overrides — engine defaults are used.
// See CustomMinimalPBR_ClaudeOpus/CustomMinimalPBR_LightUtils.azsli for an example
// of how to add per-light overrides here.
